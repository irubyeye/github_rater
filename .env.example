NODE_ENV=development
PORT=3000
SWAGGER_PATH=docs

GITHUB_TOKEN=
GITHUB_FETCH_PER_PAGE=100
GITHUB_MAX_FETCH_PAGES=1
GITHUB_REQUEST_TIMEOUT_MS=5000

SCORE_STARS_WEIGHT=0.5
